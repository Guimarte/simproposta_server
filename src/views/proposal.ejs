<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= proposal.title %> | <%= company ? company.name : 'SimAprova' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --primary: <%= company && company.primaryColor ? company.primaryColor : '#066B63' %>;
      --bg: #071A2B;
      --surface: #0A2136;
      --surface-border: #1A3D5D;
      --text-main: #F3F7F8;
      --text-muted: #8AA4B7;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg);
      color: var(--text-main);
      line-height: 1.6;
      padding-bottom: 80px;
    }

    .header {
      background-color: var(--surface);
      border-bottom: 1px solid var(--surface-border);
      padding: 16px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .brand img {
      max-height: 38px;
    }
    .brand-title {
      font-weight: 700;
      font-size: 18px;
    }

    .container {
      max-width: 800px;
      margin: 40px auto 0 auto;
      padding: 0 20px;
    }

    .hero {
      background: linear-gradient(135deg, rgba(6, 107, 99, 0.15) 0%, rgba(7, 26, 43, 0.4) 100%);
      border: 1px solid var(--surface-border);
      border-radius: 16px;
      padding: 32px;
      margin-bottom: 32px;
    }

    .hero h1 {
      font-size: 28px;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .hero-meta {
      display: flex;
      gap: 24px;
      margin-top: 20px;
      font-size: 13px;
      color: var(--text-muted);
      border-top: 1px solid var(--surface-border);
      padding-top: 16px;
    }

    .block-card {
      background-color: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 20px;
    }

    .block-card h3 {
      font-size: 18px;
      color: var(--text-main);
      margin-bottom: 12px;
      border-left: 4px solid var(--primary);
      padding-left: 12px;
    }

    .price-item {
      display: flex;
      justify-content: space-between;
      padding: 12px 0;
      border-bottom: 1px dashed var(--surface-border);
    }
    .price-item:last-child { border-bottom: none; }

    .total-box {
      background-color: var(--surface);
      border: 2px solid var(--primary);
      border-radius: 12px;
      padding: 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 32px;
    }

    .btn-accept {
      background-color: var(--primary);
      color: #fff;
      font-weight: 700;
      border: none;
      padding: 14px 28px;
      border-radius: 8px;
      font-size: 15px;
      cursor: pointer;
      transition: opacity 0.2s;
    }
    .btn-accept:hover { opacity: 0.9; }

    /* Modal Aceite */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.8);
      z-index: 200;
      align-items: center;
      justify-content: center;
    }
    .modal-content {
      background-color: var(--surface);
      border: 1px solid var(--surface-border);
      padding: 32px;
      border-radius: 16px;
      width: 100%;
      max-width: 440px;
    }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: 12px; margin-bottom: 6px; color: var(--text-muted); }
    .form-group input {
      width: 100%;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid var(--surface-border);
      background-color: var(--bg);
      color: #fff;
    }
  </style>
</head>
<body>

  <header class="header">
    <div class="brand">
      <% if (company && company.logoUrl) { %>
        <img src="<%= company.logoUrl %>" alt="Logo">
      <% } else { %>
        <span class="brand-title"><%= company ? company.name : 'SimAprova' %></span>
      <% } %>
    </div>
    <div>
      <span style="font-size: 12px; background: rgba(18, 168, 154, 0.15); color: #12A89A; padding: 6px 12px; border-radius: 20px; border: 1px solid #12A89A;">
        Proposta Comercial Oficial
      </span>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <h1><%= proposal.title %></h1>
      <p style="color: var(--text-muted);">Proposta personalizada preparada para <strong><%= proposal.clientName %></strong></p>
      
      <div class="hero-meta">
        <div><strong>Vendedor:</strong> <%= (proposal.user && proposal.user.name) ? proposal.user.name : (company ? company.name : 'Equipe Comercial') %></div>
        <div><strong>Contato:</strong> <%= (proposal.user && proposal.user.email) ? proposal.user.email : (proposal.clientEmail || '') %></div>
        <div><strong>Validade:</strong> 15 Dias</div>
      </div>
    </section>

    <% if (blocks && blocks.length > 0) { %>
      <% blocks.forEach(function(block) { %>
        <section class="block-card">
          <h3><%= block.title || 'Informações' %></h3>

          <% if (block.type === 'TEXT') { %>
            <% 
              let textContent = '';
              if (typeof block.content === 'object' && block.content !== null) {
                textContent = block.content.text || '';
              } else if (typeof block.content === 'string') {
                if (block.content.startsWith('{')) {
                  try {
                    const parsed = JSON.parse(block.content);
                    textContent = parsed.text || parsed.content || '';
                  } catch (_) { textContent = block.content; }
                } else { textContent = block.content; }
              }
            %>
            <p style="color: var(--text-muted); font-size: 15px; white-space: pre-line;"><%= textContent %></p>
          <% } %>

          <% if (block.type === 'VIDEO') { %>
            <% 
              let rawVideoUrl = '';
              if (typeof block.content === 'object' && block.content !== null) {
                rawVideoUrl = block.content.videoUrl || block.content.url || block.content.text || '';
              } else if (typeof block.content === 'string') {
                if (block.content.startsWith('{')) {
                  try {
                    const parsed = JSON.parse(block.content);
                    rawVideoUrl = parsed.videoUrl || parsed.url || parsed.text || '';
                  } catch (_) { rawVideoUrl = block.content; }
                } else { rawVideoUrl = block.content; }
              }

              // Conversão de URLs para Embed (YouTube / Vimeo)
              let embedUrl = rawVideoUrl;
              if (rawVideoUrl.includes('youtube.com/watch') || rawVideoUrl.includes('youtu.be/')) {
                const ytMatch = rawVideoUrl.match(/(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/);
                if (ytMatch && ytMatch[1]) {
                  embedUrl = 'https://www.youtube.com/embed/' + ytMatch[1];
                }
              } else if (rawVideoUrl.includes('vimeo.com/')) {
                const vmMatch = rawVideoUrl.match(/vimeo\.com\/(?:.*\/)?([0-9]+)/);
                if (vmMatch && vmMatch[1]) {
                  embedUrl = 'https://player.vimeo.com/video/' + vmMatch[1];
                }
              }
            %>

            <% if (embedUrl && (embedUrl.startsWith('http://') || embedUrl.startsWith('https://'))) { %>
              <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px; background: #000;">
                <iframe src="<%= embedUrl %>" style="position: absolute; top:0; left:0; width:100%; height:100%; border:0;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
              </div>
            <% } else { %>
              <p style="color: var(--text-muted); font-size: 14px; font-style: italic;">Vídeo explicativo não configurado.</p>
            <% } %>
          <% } %>

          <% if (block.type === 'PRICE_TABLE') { %>
            <% 
              let priceItems = [];
              let priceText = '';

              if (typeof block.content === 'object' && block.content !== null) {
                priceItems = block.content.items || [];
                priceText = block.content.text || '';
              } else if (typeof block.content === 'string') {
                if (block.content.startsWith('{')) {
                  try {
                    const parsed = JSON.parse(block.content);
                    priceItems = parsed.items || [];
                    priceText = parsed.text || parsed.content || '';
                  } catch (_) { priceText = block.content; }
                } else { priceText = block.content; }
              }
            %>

            <% if (priceItems && priceItems.length > 0) { %>
              <% priceItems.forEach(function(item) { %>
                <div class="price-item">
                  <div>
                    <strong style="font-size: 14px;"><%= item.name || item.title %></strong>
                    <p style="font-size: 12px; color: var(--text-muted);"><%= item.description || '' %></p>
                  </div>
                  <strong style="color: var(--primary);">R$ <%= parseFloat(item.price || 0).toFixed(2) %></strong>
                </div>
              <% }); %>
            <% } else if (priceText) { %>
              <div style="background: rgba(255,255,255,0.03); padding: 14px; border-radius: 8px; border: 1px solid var(--surface-border);">
                <p style="color: var(--text-main); font-size: 14px; white-space: pre-line;"><%= priceText %></p>
              </div>
            <% } else { %>
              <p style="color: var(--text-muted); font-size: 14px;">Tabela de preços personalizada inclusa no valor total.</p>
            <% } %>
          <% } %>
        </section>
      <% }); %>
    <% } %>

    <section class="total-box">
      <div>
        <span style="font-size: 13px; color: var(--text-muted);">Investimento Total da Proposta</span>
        <h2 style="font-size: 26px; color: var(--primary);">R$ <%= parseFloat(proposal.totalValue || 0).toFixed(2) %></h2>
      </div>

      <% if (proposal.status === 'ACCEPTED') { %>
        <div style="background: rgba(18, 168, 154, 0.2); border: 1px solid #12A89A; color: #12A89A; padding: 12px 20px; border-radius: 8px; font-weight: bold;">
          ✓ Proposta Aprovada Digitalmente
        </div>
      <% } else { %>
        <button class="btn-accept" onclick="document.getElementById('modalAccept').style.display='flex'">
          Aprovar Proposta Digitalmente
        </button>
      <% } %>
    </section>
  </main>

  <!-- Modal de Aceite Digital -->
  <div id="modalAccept" class="modal">
    <div class="modal-content">
      <h3 style="margin-bottom: 8px;">Aceite Digital da Proposta</h3>
      <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 20px;">
        Ao assinar abaixo, você concorda com os valores e escopo descritos nesta proposta.
      </p>

      <form id="formAccept" onsubmit="handleAccept(event)">
        <div class="form-group">
          <label>Seu Nome Completo</label>
          <input type="text" id="signerName" required placeholder="Ex: Roberto Silva">
        </div>
        <div class="form-group">
          <label>CPF ou CNPJ</label>
          <input type="text" id="signerDoc" required placeholder="000.000.000-00">
        </div>
        <div class="form-group">
          <label>Seu E-mail Corporativo</label>
          <input type="email" id="signerEmail" required placeholder="roberto@empresa.com">
        </div>

        <div style="display: flex; gap: 12px; margin-top: 24px;">
          <button type="button" class="btn-accept" style="background: transparent; border: 1px solid var(--surface-border); flex: 1;" onclick="document.getElementById('modalAccept').style.display='none'">Cancelar</button>
          <button type="submit" class="btn-accept" style="flex: 2;">Assinar & Aprovar</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Rastreamento em tempo real de abertura
    fetch('/api/track/open', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ proposalId: '<%= proposal.id %>', userAgent: navigator.userAgent })
    });

    // Submissão de Aceite Digital
    async function handleAccept(e) {
      e.preventDefault();
      const name = document.getElementById('signerName').value;
      const doc = document.getElementById('signerDoc').value;
      const email = document.getElementById('signerEmail').value;

      try {
        const res = await fetch('/api/proposals/<%= proposal.id %>/accept', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ signerName: name, signerDoc: doc, signerEmail: email })
        });
        
        if (res.ok) {
          alert('🎉 Proposta Aprovada com Sucesso! Um comprovante foi gerado.');
          window.location.reload();
        } else {
          alert('Erro ao aprovar proposta. Tente novamente.');
        }
      } catch (err) {
        alert('Falha na conexão.');
      }
    }
  </script>
</body>
</html>
