<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Proposta Comercial - <%= proposal.title %></title>
  <style>
    body {
      font-family: 'Segoe UI', Roboto, -apple-system, BlinkMacSystemFont, Helvetica, Arial, sans-serif;
      background-color: #051322;
      color: #F3F7F8;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }
    .wrapper {
      width: 100%;
      background-color: #051322;
      padding: 40px 12px;
    }
    .main-card {
      max-width: 620px;
      margin: 0 auto;
      background-color: #0A2136;
      border: 1px solid #1A3D5D;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
    }
    .header {
      background: linear-gradient(180deg, #0D2A44 0%, #0A2136 100%);
      padding: 32px;
      text-align: center;
      border-bottom: 1px solid #1A3D5D;
    }
    .company-brand {
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -0.5px;
      color: <%= company && company.primaryColor ? company.primaryColor : '#066B63' %>;
      margin: 0;
    }
    .badge-official {
      display: inline-block;
      margin-top: 10px;
      padding: 4px 14px;
      background-color: rgba(6, 107, 99, 0.18);
      border: 1px solid <%= company && company.primaryColor ? company.primaryColor : '#066B63' %>;
      color: <%= company && company.primaryColor ? company.primaryColor : '#066B63' %>;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .content {
      padding: 36px 32px;
    }
    .greeting {
      font-size: 15px;
      color: #8AA4B7;
      margin-bottom: 8px;
    }
    .proposal-title {
      font-size: 24px;
      font-weight: 800;
      color: #FFFFFF;
      margin: 0 0 20px 0;
      line-height: 1.3;
    }

    /* Tabela Executiva de Resumo */
    .executive-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      margin: 28px 0;
      background-color: #071A2B;
      border: 1px solid #1A3D5D;
      border-radius: 14px;
      overflow: hidden;
    }
    .executive-table th {
      background-color: #0D2A44;
      color: #8AA4B7;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      padding: 14px 18px;
      text-align: left;
      border-bottom: 1px solid #1A3D5D;
    }
    .executive-table td {
      padding: 14px 18px;
      font-size: 14px;
      color: #F3F7F8;
      border-bottom: 1px solid #122B42;
    }
    .executive-table tr:last-child td {
      border-bottom: none;
    }
    .table-highlight-row {
      background-color: rgba(6, 107, 99, 0.12);
    }
    .table-highlight-row td {
      border-top: 1px solid <%= company && company.primaryColor ? company.primaryColor : '#066B63' %>;
    }
    .price-total-tag {
      font-size: 20px;
      font-weight: 800;
      color: <%= company && company.primaryColor ? company.primaryColor : '#066B63' %>;
    }

    /* Bloco de Escopo */
    .scope-box {
      background-color: #071A2B;
      border: 1px solid #1A3D5D;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 28px;
    }
    .scope-title {
      font-size: 13px;
      font-weight: 700;
      color: #8AA4B7;
      text-transform: uppercase;
      margin-bottom: 10px;
    }
    .scope-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      color: #F3F7F8;
      margin-bottom: 6px;
    }
    .scope-dot {
      width: 6px;
      height: 6px;
      background-color: <%= company && company.primaryColor ? company.primaryColor : '#066B63' %>;
      border-radius: 50%;
    }

    .btn-container {
      text-align: center;
      margin: 36px 0 16px 0;
    }
    .cta-btn {
      background: linear-gradient(135deg, <%= company && company.primaryColor ? company.primaryColor : '#066B63' %> 0%, <%= company && company.primaryColor ? company.primaryColor : '#066B63' %> 100%);
      color: #FFFFFF !important;
      text-decoration: none;
      font-weight: 800;
      font-size: 16px;
      padding: 18px 42px;
      border-radius: 12px;
      display: inline-block;
      box-shadow: 0 6px 20px rgba(6, 107, 99, 0.35);
      letter-spacing: 0.3px;
    }
    .footer {
      background-color: #051322;
      padding: 24px 32px;
      text-align: center;
      font-size: 12px;
      color: #8AA4B7;
      border-top: 1px solid #1A3D5D;
      line-height: 1.6;
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="main-card">
      <div class="header">
        <% if (company && company.logoUrl) { %>
          <img src="<%= company.logoUrl %>" alt="<%= company.name %>" style="max-height: 52px; display: block; margin: 0 auto;">
        <% } else { %>
          <h2 class="company-brand"><%= company ? company.name : 'SimAprova' %></h2>
        <% } %>
        <span class="badge-official">✓ Proposta Comercial Oficial</span>
      </div>

      <div class="content">
        <div class="greeting">Prezado(a) <strong><%= proposal.clientName %></strong>,</div>
        <h1 class="proposal-title"><%= proposal.title %></h1>

        <!-- Tabela Executiva de Resumo Financeiro & Condições -->
        <table class="executive-table">
          <thead>
            <tr>
              <th width="60%">ESPECIFICAÇÃO DO PROJETO</th>
              <th width="40%" align="right">DETALHES / VALORES</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Cliente Destinatário</strong></td>
              <td align="right"><%= proposal.clientName %></td>
            </tr>
            <tr>
              <td><strong>Responsável Comercial</strong></td>
              <td align="right"><%= (proposal.user && proposal.user.name) ? proposal.user.name : (company ? company.name : 'Equipe Comercial') %></td>
            </tr>
            <tr>
              <td><strong>Prazo de Validade</strong></td>
              <td align="right">15 Dias Úteis</td>
            </tr>
            <tr class="table-highlight-row">
              <td>
                <strong style="font-size: 15px; color: #FFFFFF;">INVESTIMENTO TOTAL</strong><br>
                <span style="font-size: 11px; color: #8AA4B7;">Condições exclusivas aplicadas</span>
              </td>
              <td align="right" class="price-total-tag">
                R$ <%= parseFloat(proposal.totalValue || 0).toFixed(2) %>
              </td>
            </tr>
          </tbody>
        </table>

        <!-- Resumo dos Blocos da Proposta -->
        <% if (proposal.blocks && proposal.blocks.length > 0) { %>
          <div class="scope-box">
            <div class="scope-title">Conteúdo Incluso nesta Proposta:</div>
            <% proposal.blocks.forEach(function(b) { %>
              <div class="scope-item">
                <span class="scope-dot"></span>
                <strong><%= b.title || 'Informações Gerais' %></strong>
                <span style="color: #8AA4B7; font-size: 11px;">(<%= b.type %>)</span>
              </div>
            <% }); %>
          </div>
        <% } %>

        <div class="btn-container">
          <a href="<%= publicUrl %>" target="_blank" class="cta-btn">
            📄 Acessar Proposta Comercial & Aceite Digital
          </a>
        </div>
      </div>

      <div class="footer">
        Esta proposta foi enviada por <strong><%= company ? company.name : 'SimAprova' %></strong> através da plataforma SimAprova SaaS.<br>
        <strong>Acordo Sólido — Confiança Imediatamente Visível.</strong>
      </div>
    </div>
  </div>
</body>
</html>
